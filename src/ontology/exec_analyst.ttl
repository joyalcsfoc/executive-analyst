# GENERATED by src/ontology/generate_owl.py — do not edit by hand.
# Source: src/ontology/glossary.yml + src/ontology/graph.yml
# Regenerate: python src/ontology/generate_owl.py
#            (or ./deploy.sh regen-tags)
#
@prefix ea: <https://focaloid.com/ontology/executive-analyst#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://focaloid.com/ontology/executive-analyst> a owl:Ontology ;
    rdfs:comment "Executive Analyst OWL TBox generated from glossary.yml and graph.yml. KPI math lives in Unity Catalog metric views; this file is meaning only. Instance graph is ontology.kg_nodes / kg_edges in Unity Catalog."@en .

ea:hasLine a owl:ObjectProperty ;
    rdfs:label "hasLine" ;
    rdfs:comment "Plant contains a production line. Materialized from distinct (PLANT_KEY, LINE_KEY) on fact_production_execution — not from dim alone."@en ;
    rdfs:domain ea:Plant ;
    rdfs:range ea:ProductionLine .

ea:ownedBy a owl:AnnotationProperty ;
    rdfs:label "ownedBy" ;
    rdfs:comment "Glossary owner (finance, marketing, …)"@en .

ea:produces a owl:ObjectProperty ;
    rdfs:label "produces" ;
    rdfs:comment "Production line runs a vehicle model. Distinct (LINE_KEY, MODEL_KEY) on fact_production_execution."@en ;
    rdfs:domain ea:ProductionLine ;
    rdfs:range ea:Model .

ea:realizedByField a owl:AnnotationProperty ;
    rdfs:label "realizedByField" ;
    rdfs:comment "Catalog-relative view.field path"@en .

ea:realizedByMeasure a owl:AnnotationProperty ;
    rdfs:label "realizedByMeasure" ;
    rdfs:comment "Catalog-relative view.measure path"@en .

ea:realizedByTable a owl:AnnotationProperty ;
    rdfs:label "realizedByTable" ;
    rdfs:comment "Catalog-relative dim table path"@en .

ea:realizedByView a owl:AnnotationProperty ;
    rdfs:label "realizedByView" ;
    rdfs:comment "Catalog-relative metric view path"@en .

ea:runsOnChannel a owl:ObjectProperty ;
    rdfs:label "runsOnChannel" ;
    rdfs:comment "Campaign flight on a media channel. Distinct (CAMPAIGN_KEY, CHANNEL_KEY) on fact_campaign_performance."@en ;
    rdfs:domain ea:Campaign ;
    rdfs:range ea:Channel .

ea:runsOnSegment a owl:ObjectProperty ;
    rdfs:label "runsOnSegment" ;
    rdfs:comment "Campaign flight targeting a customer segment. Distinct (CAMPAIGN_KEY, SEGMENT_KEY) on fact_campaign_performance."@en ;
    rdfs:domain ea:Campaign ;
    rdfs:range ea:Segment .

ea:soldBy a owl:ObjectProperty ;
    rdfs:label "soldBy" ;
    rdfs:comment "Model sold through a dealer. Distinct (MODEL_KEY, DEALER_KEY) on fact_sales_order."@en ;
    rdfs:domain ea:Model ;
    rdfs:range ea:Dealer .

ea:stockedAt a owl:ObjectProperty ;
    rdfs:label "stockedAt" ;
    rdfs:comment "Part stocked at a warehouse on the current inventory snapshot only (is_current_snapshot / latest SNAPSHOT_DATE_KEY)."@en ;
    rdfs:domain ea:Part ;
    rdfs:range ea:Warehouse .

ea:supplies a owl:ObjectProperty ;
    rdfs:label "supplies" ;
    rdfs:comment "Supplier supplies a part (incoming quality). Distinct (SUPPLIER_KEY, PART_KEY) on fact_supplier_quality."@en ;
    rdfs:domain ea:Supplier ;
    rdfs:range ea:Part .

ea:DaysOfSupply a owl:Class ;
    rdfs:label "Days of supply"@en ;
    rdfs:comment "Point-in-time cover days (DAYS_OF_SUPPLY). Do not treat as cumulative across snapshot dates."@en ;
    rdfs:subClassOf ea:Measure ;
    skos:related ea:InventoryTurnover,
        ea:StockoutRisk ;
    ea:ownedBy "supply_chain" ;
    ea:realizedByMeasure "supply_chain_analytics.metrics_inventory_snapshot.average_days_of_supply" .

ea:Downtime a owl:Class ;
    rdfs:label "Downtime"@en ;
    rdfs:comment "Production downtime duration in minutes (column DOWNTIME_MIN). MEASURE(total_downtime)."@en ;
    rdfs:subClassOf ea:Measure ;
    skos:related ea:Oee ;
    ea:ownedBy "manufacturing" ;
    ea:realizedByMeasure "manufacturing_analytics.metrics_production_execution.total_downtime" .

ea:StockoutRisk a owl:Class ;
    rdfs:label "Stockout risk"@en ;
    rdfs:comment "Point-in-time risk band LOW / MEDIUM / HIGH. HIGH means QUANTITY_ON_HAND below SAFETY_STOCK_QTY. For current status filter is_current_snapshot = true; never sum on-hand across dates."@en ;
    rdfs:subClassOf ea:Measure ;
    skos:related ea:DaysOfSupply ;
    ea:ownedBy "supply_chain" ;
    ea:realizedByField "supply_chain_analytics.metrics_inventory_snapshot.high_stockout",
        "supply_chain_analytics.metrics_inventory_snapshot.stockout_risk" .

ea:AmbiguousTerm a owl:Class ;
    rdfs:label "Ambiguous term"@en ;
    rdfs:comment "Disambiguation term with no asset links; Genie should clarify"@en .

ea:Bookings a owl:Class ;
    rdfs:label "Bookings"@en ;
    rdfs:comment "Booked / pipeline value. Sum of BOOKING_AMOUNT. INR. Not recognized revenue."@en ;
    rdfs:subClassOf ea:Measure ;
    owl:disjointWith ea:Revenue ;
    skos:related ea:Revenue ;
    ea:ownedBy "finance" ;
    ea:realizedByMeasure "revenue_analytics.metrics_sales_order.total_bookings" .

ea:ConversionMarketing a owl:Class ;
    rdfs:label "Conversion (marketing)"@en ;
    rdfs:comment "Campaign CONVERSIONS on fact_campaign_performance / metrics_campaign_performance. Not the same as sales-order DELIVERED status."@en ;
    rdfs:subClassOf ea:Measure ;
    owl:disjointWith ea:DeliveredOrder ;
    skos:related ea:DeliveredOrder ;
    ea:ownedBy "marketing" ;
    ea:realizedByMeasure "marketing_analytics.metrics_campaign_performance.total_conversions" .

ea:Cpl a owl:Class ;
    rdfs:label "CPL"@en ;
    rdfs:comment "Cost per lead. MEASURE(cost_per_lead) = SUM(ACTUAL_SPEND) / SUM(LEADS). INR per lead. Never AVG(COST_PER_LEAD). One sense of ambiguous \"cost\"."@en ;
    rdfs:subClassOf ea:Measure ;
    skos:related ea:Cost,
        ea:Roas ;
    ea:ownedBy "marketing" ;
    ea:realizedByMeasure "marketing_analytics.metrics_campaign_performance.cost_per_lead" .

ea:Dealer a owl:Class ;
    rdfs:label "Dealer"@en ;
    rdfs:comment "Sales channel partner. Use dealer_name (dim_dealer)."@en ;
    rdfs:subClassOf ea:Entity ;
    skos:related ea:Model ;
    ea:ownedBy "finance" ;
    ea:realizedByField "revenue_analytics.metrics_sales_order.dealer_name" ;
    ea:realizedByTable "dim.dim_dealer" .

ea:DeliveredOrder a owl:Class ;
    rdfs:label "Delivered order"@en ;
    rdfs:comment "Sales order with STATUS = DELIVERED. Pipeline sequence PROCESSING → CONFIRMED → DELIVERED. Not the same as marketing Conversion."@en ;
    rdfs:subClassOf ea:Measure ;
    owl:disjointWith ea:ConversionMarketing ;
    skos:related ea:ConversionMarketing ;
    ea:ownedBy "finance" ;
    ea:realizedByField "revenue_analytics.metrics_sales_order.order_status" ;
    ea:realizedByMeasure "revenue_analytics.metrics_sales_order.delivered_order_revenue" .

ea:DiscountPercent a owl:Class ;
    rdfs:label "Discount percent"@en ;
    rdfs:comment "Discount as a share of revenue. MEASURE(discount_percent) = 100 * SUM(DISCOUNT_AMOUNT) / SUM(ORDER_AMOUNT). Unit is percent on a 0-100 scale, not INR — never render with a currency symbol. Never AVG per-order ratios."@en ;
    rdfs:subClassOf ea:Measure ;
    owl:disjointWith ea:Discount ;
    skos:related ea:Discount,
        ea:Revenue ;
    ea:ownedBy "finance" ;
    ea:realizedByMeasure "revenue_analytics.metrics_sales_order.discount_percent" .

ea:Efficiency a owl:Class ;
    rdfs:label "Efficiency"@en ;
    rdfs:comment "Ambiguous. Clarify before querying: production OEE vs inventory turnover."@en ;
    rdfs:subClassOf ea:AmbiguousTerm ;
    skos:related ea:InventoryTurnover,
        ea:Oee ;
    ea:ownedBy "executive_analyst" .

ea:InventoryTurnover a owl:Class ;
    rdfs:label "Inventory turnover"@en ;
    rdfs:comment "Point-in-time INVENTORY_TURNOVER_RATIO. Other sense of ambiguous \"efficiency\" (not OEE). Do not average blindly across mixed snapshot dates."@en ;
    rdfs:subClassOf ea:Measure ;
    owl:disjointWith ea:Oee ;
    skos:related ea:Efficiency,
        ea:Oee ;
    ea:ownedBy "supply_chain" ;
    ea:realizedByMeasure "supply_chain_analytics.metrics_inventory_snapshot.average_turnover" .

ea:Ppm a owl:Class ;
    rdfs:label "PPM"@en ;
    rdfs:comment "Parts-per-million defect rate. MEASURE(ppm) = SUM(DEFECT_QTY) / SUM(INSPECTED_QTY) * 1e6. Lower is better. Never SUM(PPM_LEVEL)."@en ;
    rdfs:subClassOf ea:Measure ;
    skos:related ea:Copq ;
    ea:ownedBy "quality" ;
    ea:realizedByMeasure "supply_chain_analytics.metrics_supplier_quality.ppm" .

ea:Roas a owl:Class ;
    rdfs:label "ROAS"@en ;
    rdfs:comment "Spend-weighted return on ad spend MEASURE(weighted_roas). Values > 1.0 are a positive return. Never AVG(ROAS)."@en ;
    rdfs:subClassOf ea:Measure ;
    skos:related ea:Cpl ;
    ea:ownedBy "marketing" ;
    ea:realizedByMeasure "marketing_analytics.metrics_campaign_performance.weighted_roas" .

ea:Supplier a owl:Class ;
    rdfs:label "Supplier"@en ;
    rdfs:comment "Incoming-quality vendor. Use supplier_name (dim_supplier)."@en ;
    rdfs:subClassOf ea:Entity ;
    skos:related ea:Copq,
        ea:Part,
        ea:Ppm ;
    ea:ownedBy "quality" ;
    ea:realizedByField "supply_chain_analytics.metrics_supplier_quality.supplier_name" ;
    ea:realizedByTable "dim.dim_supplier" .

ea:Warehouse a owl:Class ;
    rdfs:label "Warehouse"@en ;
    rdfs:comment "Stock location. Use warehouse_name (dim_warehouse)."@en ;
    rdfs:subClassOf ea:Entity ;
    skos:related ea:Part ;
    ea:ownedBy "supply_chain" ;
    ea:realizedByField "supply_chain_analytics.metrics_inventory_snapshot.warehouse_name" ;
    ea:realizedByTable "dim.dim_warehouse" .

ea:Channel a owl:Class ;
    rdfs:label "Channel"@en ;
    rdfs:comment "Marketing media channel. Use channel_name (dim_channel)."@en ;
    rdfs:subClassOf ea:Entity ;
    skos:related ea:Campaign,
        ea:Segment ;
    ea:ownedBy "marketing" ;
    ea:realizedByField "marketing_analytics.metrics_campaign_performance.channel_name" ;
    ea:realizedByTable "dim.dim_channel" .

ea:Copq a owl:Class ;
    rdfs:label "COPQ"@en ;
    rdfs:comment "Cost of poor quality. Sum of COST_OF_POOR_QUALITY. INR. Another sense of ambiguous \"cost\"."@en ;
    rdfs:subClassOf ea:Measure ;
    skos:related ea:Cost,
        ea:Ppm ;
    ea:ownedBy "quality" ;
    ea:realizedByMeasure "supply_chain_analytics.metrics_supplier_quality.copq" .

ea:Cost a owl:Class ;
    rdfs:label "Cost"@en ;
    rdfs:comment "Ambiguous. Clarify before querying: campaign spend/CPL, quality COPQ, or order discount."@en ;
    rdfs:subClassOf ea:AmbiguousTerm ;
    skos:related ea:Copq,
        ea:Cpl,
        ea:Discount ;
    ea:ownedBy "executive_analyst" .

ea:Discount a owl:Class ;
    rdfs:label "Discount"@en ;
    rdfs:comment "Discount given on orders. Sum of DISCOUNT_AMOUNT. INR. One sense of ambiguous \"cost\"."@en ;
    rdfs:subClassOf ea:Measure ;
    owl:disjointWith ea:DiscountPercent ;
    skos:related ea:Cost,
        ea:DiscountPercent ;
    ea:ownedBy "finance" ;
    ea:realizedByMeasure "revenue_analytics.metrics_sales_order.total_discount" .

ea:Model a owl:Class ;
    rdfs:label "Model"@en ;
    rdfs:comment "Vehicle / product model. Use model_name (dim_vehicle_model)."@en ;
    rdfs:subClassOf ea:Entity ;
    skos:related ea:Dealer,
        ea:Plant ;
    ea:ownedBy "finance" ;
    ea:realizedByField "manufacturing_analytics.metrics_production_execution.model_name",
        "revenue_analytics.metrics_sales_order.model_name" ;
    ea:realizedByTable "dim.dim_vehicle_model" .

ea:Plant a owl:Class ;
    rdfs:label "Plant"@en ;
    rdfs:comment "Manufacturing site. Use plant_name from metrics_production_execution (dim_plant)."@en ;
    rdfs:subClassOf ea:Entity ;
    skos:related ea:ProductionLine ;
    ea:ownedBy "manufacturing" ;
    ea:realizedByField "manufacturing_analytics.metrics_production_execution.plant_name" ;
    ea:realizedByTable "dim.dim_plant" .

ea:ProductionLine a owl:Class ;
    rdfs:label "Production line"@en ;
    rdfs:comment "Line inside a plant. Use line_name (dim_production_line). No dim_shift; shift is shift_code on the fact."@en ;
    rdfs:subClassOf ea:Entity ;
    skos:related ea:Plant ;
    ea:ownedBy "manufacturing" ;
    ea:realizedByField "manufacturing_analytics.metrics_production_execution.line_name" ;
    ea:realizedByTable "dim.dim_production_line" .

ea:Revenue a owl:Class ;
    rdfs:label "Revenue"@en ;
    rdfs:comment "Default sales KPI. Sum of ORDER_AMOUNT on sales orders. Currency INR. Do not substitute BOOKING_AMOUNT unless the user asks for bookings."@en ;
    rdfs:subClassOf ea:Measure ;
    owl:disjointWith ea:Bookings ;
    skos:related ea:Bookings ;
    ea:ownedBy "finance" ;
    ea:realizedByMeasure "revenue_analytics.metrics_sales_order.total_revenue" .

ea:Segment a owl:Class ;
    rdfs:label "Segment"@en ;
    rdfs:comment "Customer segment. Use segment_name (dim_customer_segment)."@en ;
    rdfs:subClassOf ea:Entity ;
    skos:related ea:Campaign,
        ea:Channel ;
    ea:ownedBy "marketing" ;
    ea:realizedByField "marketing_analytics.metrics_campaign_performance.segment_name" ;
    ea:realizedByTable "dim.dim_customer_segment" .

ea:Campaign a owl:Class ;
    rdfs:label "Campaign"@en ;
    rdfs:comment "Marketing campaign. Use campaign_name (dim_campaign)."@en ;
    rdfs:subClassOf ea:Entity ;
    skos:related ea:Channel,
        ea:Roas,
        ea:Segment ;
    ea:ownedBy "marketing" ;
    ea:realizedByField "marketing_analytics.metrics_campaign_performance.campaign_name" ;
    ea:realizedByTable "dim.dim_campaign" .

ea:Oee a owl:Class ;
    rdfs:label "OEE"@en ;
    rdfs:comment "Overall equipment effectiveness. Stored as 0–100 percent (availability × performance × quality components also 0–100). \"Below 70%\" means OEE_PCT < 70 or oee_below_70. Display with one decimal in summaries. One sense of ambiguous \"efficiency\"."@en ;
    rdfs:subClassOf ea:Measure ;
    skos:related ea:Downtime,
        ea:Efficiency ;
    ea:ownedBy "manufacturing" ;
    ea:realizedByField "manufacturing_analytics.metrics_production_execution.oee_below_70" ;
    ea:realizedByMeasure "manufacturing_analytics.metrics_production_execution.average_oee" .

ea:Part a owl:Class ;
    rdfs:label "Part"@en ;
    rdfs:comment "SKU / component. Use part_name from inventory and supplier-quality metric views (dim_part)."@en ;
    rdfs:subClassOf ea:Entity ;
    skos:related ea:Supplier,
        ea:Warehouse ;
    ea:ownedBy "supply_chain" ;
    ea:realizedByField "supply_chain_analytics.metrics_inventory_snapshot.part_name",
        "supply_chain_analytics.metrics_supplier_quality.part_name" ;
    ea:realizedByTable "dim.dim_part" .

ea:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "Business entity backed by a dimension table"@en .

ea:Measure a owl:Class ;
    rdfs:label "Measure"@en ;
    rdfs:comment "KPI / measure / field concept linked to metric views"@en .
