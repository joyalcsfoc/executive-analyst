@prefix mfg: <http://msil.example.org/ontology/automotive-manufacturing#> .
@prefix ea: <https://focaloid.com/ontology/executive-analyst#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://focaloid.com/ontology/executive-analyst> a owl:Ontology ;
    rdfs:label "Executive Analyst Ontology — Automotive Manufacturing (gold binding)" ;
    rdfs:comment "SOURCE OF TRUTH. The Executive Analyst slice of the enterprise automotive-manufacturing ontology, pruned to the assets the agent is actually connected to (five facts, five metric views, eleven dims in the gold catalog) and annotated with the Databricks bindings the enterprise TTL does not carry. Class IRIs are reused verbatim from mfg: so this file stays compatible with automotive_manufacturing_ontology.ttl; Executive-Analyst-specific KPI and ambiguity concepts live in ea:. Modeling rules follow the enterprise ontology: type/category attributes become class taxonomies closed with owl:AllDisjointClasses, status attributes become enumerated classes with named individuals whose rdfs:label is the literal warehouse value, and foreign keys become object properties with declared inverses. Everything downstream — UC tags, kg_nodes/kg_edges, the traversal functions and the HTML reference — is generated from this file by generate.py. Do not hand-edit the generated artifacts." ;
    owl:versionInfo "2.0" ;
    ea:catalogNote "Bindings are catalog-relative: 'schema.table'. The generator prepends the job's {{catalog}} parameter (gold_dev in dev, gold in prod)." .


##############################################################################
# BINDING VOCABULARY — the layer the enterprise TTL lacks
##############################################################################

ea:boundToTable a owl:AnnotationProperty ;
    rdfs:label "bound to table" ;
    rdfs:comment "Catalog-relative 'schema.table' that holds the instances of this class. Presence makes the class a kg_nodes producer." .

ea:boundToKeyColumn a owl:AnnotationProperty ;
    rdfs:label "bound to key column" ;
    rdfs:comment "Surrogate key column in the bound table. Becomes kg_nodes.node_key." .

ea:boundToNameColumn a owl:AnnotationProperty ;
    rdfs:label "bound to name column" ;
    rdfs:comment "Business-name column in the bound table. Becomes kg_nodes.node_name." .

ea:boundToView a owl:AnnotationProperty ;
    rdfs:label "bound to metric view" ;
    rdfs:comment "Catalog-relative 'schema.metric_view' that governs this concept's KPI math." .

ea:boundToMeasure a owl:AnnotationProperty ;
    rdfs:label "bound to measure" ;
    rdfs:comment "MEASURE() name inside the bound metric view. The governed way to compute this KPI." .

ea:boundToField a owl:AnnotationProperty ;
    rdfs:label "bound to field" ;
    rdfs:comment "Dimension or flag field inside the bound metric view." .

ea:boundToColumn a owl:AnnotationProperty ;
    rdfs:label "bound to column" ;
    rdfs:comment "Catalog-relative 'schema.table.COLUMN' this concept is realized by. Used on enums to bind controlled vocabularies to the column that carries them." .

ea:domainTag a owl:AnnotationProperty ;
    rdfs:label "domain tag" ;
    rdfs:comment "Value written to the UC 'domain' tag on the bound metric view." .

ea:grainTag a owl:AnnotationProperty ;
    rdfs:label "grain tag" ;
    rdfs:comment "Value written to the UC 'grain' tag on the bound metric view." .

ea:notSameAs a owl:AnnotationProperty ;
    rdfs:label "not same as" ;
    rdfs:comment "Two concepts users routinely conflate. Emitted into UC comments so the agent stops substituting one for the other." .

ea:disambiguatesTo a owl:AnnotationProperty ;
    rdfs:label "disambiguates to" ;
    rdfs:comment "An ambiguous surface term resolves to one of these concepts. The agent must ask which before querying." .

ea:aka a owl:AnnotationProperty ;
    rdfs:label "also known as" ;
    rdfs:comment "Synonym a user might say for this concept. Emitted into UC tags for entity matching." .

ea:edgeFrom a owl:AnnotationProperty ;
    rdfs:label "edge from" ;
    rdfs:comment "Catalog-relative fact table whose distinct key pairs materialize this object property into kg_edges." .

ea:edgeSubjectKey a owl:AnnotationProperty ;
    rdfs:label "edge subject key" ;
    rdfs:comment "Column in the edge fact table holding the domain class's key." .

ea:edgeObjectKey a owl:AnnotationProperty ;
    rdfs:label "edge object key" ;
    rdfs:comment "Column in the edge fact table holding the range class's key." .

ea:edgeFilter a owl:AnnotationProperty ;
    rdfs:label "edge filter" ;
    rdfs:comment "SQL predicate applied when materializing this edge, e.g. restricting a snapshot fact to its current day." .

ea:catalogNote a owl:AnnotationProperty ;
    rdfs:label "catalog note" .


##############################################################################
# 0. UPPER ONTOLOGY — reused verbatim from the enterprise ontology
##############################################################################

mfg:Agent a owl:Class ;
    rdfs:comment "Any entity capable of independent action: an organization, a person, or a software system." .

mfg:Organization a owl:Class ;
    rdfs:subClassOf mfg:Agent ;
    rdfs:comment "A formally constituted party: a company, supplier, dealer or fleet account." .

mfg:Person a owl:Class ;
    rdfs:subClassOf mfg:Agent ;
    rdfs:comment "An individual human being." .

mfg:SoftwareAgent a owl:Class ;
    rdfs:subClassOf mfg:Agent ;
    rdfs:comment "An autonomous software system that acts on the enterprise's behalf." .

mfg:PhysicalArtifact a owl:Class ;
    rdfs:comment "Anything with a physical, tangible existence." .

mfg:Location a owl:Class ;
    rdfs:comment "An abstract place: a physical site, a geographic point, or an address." .

mfg:Facility a owl:Class ;
    rdfs:subClassOf mfg:PhysicalArtifact ;
    rdfs:subClassOf mfg:Location ;
    rdfs:comment "A physical site or area where the enterprise operates: a plant, warehouse or production line." .

mfg:Equipment a owl:Class ;
    rdfs:subClassOf mfg:PhysicalArtifact ;
    rdfs:comment "A physical asset used to perform work: machinery, tooling, vehicles used in transport." .

mfg:Product a owl:Class ;
    rdfs:subClassOf mfg:PhysicalArtifact ;
    rdfs:comment "Anything the enterprise manufactures, sources or sells as a physical good." .

mfg:Process a owl:Class ;
    rdfs:comment "A structured activity made up of steps, carried out to achieve a business outcome." .

mfg:Event a owl:Class ;
    rdfs:comment "Something that happens at a point in time and is recorded: a transaction, a decision, a delivery." .

mfg:Document a owl:Class ;
    rdfs:comment "An artifact that records information for business or legal purposes." .

mfg:Policy a owl:Class ;
    rdfs:comment "A business rule or standing configuration that governs future behavior." .

mfg:Measurement a owl:Class ;
    rdfs:comment "A quantified observation or KPI computed about another entity: a quality score, an OEE figure, a risk rating." .

[] a owl:AllDisjointClasses ;
    rdfs:label "Top-level categories are mutually exclusive" ;
    owl:members ( mfg:PhysicalArtifact mfg:Process mfg:Event mfg:Document mfg:Policy mfg:Measurement mfg:Location ) .

mfg:involvesAgent a owl:ObjectProperty ;
    rdfs:domain mfg:Event ;
    rdfs:range mfg:Agent ;
    rdfs:comment "The agent responsible for or party to an event." .

mfg:occursAt a owl:ObjectProperty ;
    rdfs:domain mfg:Event ;
    rdfs:range mfg:Location ;
    rdfs:comment "Where an event took place." .

mfg:partOf a owl:ObjectProperty ;
    rdfs:domain mfg:PhysicalArtifact ;
    rdfs:range mfg:PhysicalArtifact ;
    rdfs:comment "Generic mereological relation: one physical artifact is a part of another." .

mfg:hasPart a owl:ObjectProperty ;
    rdfs:domain mfg:PhysicalArtifact ;
    rdfs:range mfg:PhysicalArtifact ;
    rdfs:comment "Inverse of partOf." ;
    owl:inverseOf mfg:partOf .

ea:KPI a owl:Class ;
    rdfs:subClassOf mfg:Measurement ;
    rdfs:comment "A governed executive KPI. Every KPI binds to exactly one metric view and one MEASURE() inside it — that binding is the only sanctioned way to compute it." .

ea:AmbiguousTerm a owl:Class ;
    rdfs:comment "A surface word users say that maps to more than one KPI. The agent must ask which sense is meant before querying." .

mfg:CalendarDate a owl:Class ;
    rdfs:comment "A single day on the enterprise calendar, the shared time grain across all five domains." ;
    ea:boundToTable "dim.dim_date" ;
    ea:boundToKeyColumn "DATE_KEY" ;
    ea:boundToNameColumn "FULL_DATE" ;
    ea:aka "date", "day" .

ea:hasDateKey a owl:DatatypeProperty ;
    rdfs:domain mfg:CalendarDate ;
    rdfs:range xsd:integer ;
    rdfs:comment "Surrogate date key as an INT in YYYYMMDD form. Convert with TO_DATE(CAST(key AS STRING), 'yyyyMMdd') when dim_date is not joined." ;
    a owl:FunctionalProperty .

ea:hasFullDate a owl:DatatypeProperty ;
    rdfs:domain mfg:CalendarDate ;
    rdfs:range xsd:date ;
    rdfs:comment "The calendar date itself." ;
    a owl:FunctionalProperty .


##############################################################################
# 0.1 SHARED ENUMERATIONS — labels are the literal warehouse values
##############################################################################

mfg:RiskLevel a owl:Class ;
    rdfs:comment "A three-level qualitative risk rating. In the gold slice it carries STOCKOUT_RISK: HIGH means QUANTITY_ON_HAND is below SAFETY_STOCK_QTY, MEDIUM means approaching it, LOW means adequate cover." ;
    ea:boundToColumn "supply_chain_analytics.fact_inventory_snapshot.STOCKOUT_RISK" ;
    ea:boundToView "supply_chain_analytics.metrics_inventory_snapshot" ;
    ea:boundToField "Stockout Risk" ;
    ea:aka "stockout risk", "stock risk", "risk band" ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( mfg:RiskLevel_LOW mfg:RiskLevel_MEDIUM mfg:RiskLevel_HIGH ) ] .
mfg:RiskLevel_LOW a mfg:RiskLevel ;
    rdfs:label "LOW" .
mfg:RiskLevel_MEDIUM a mfg:RiskLevel ;
    rdfs:label "MEDIUM" .
mfg:RiskLevel_HIGH a mfg:RiskLevel ;
    rdfs:label "HIGH" .


##############################################################################
# 1. REVENUE & SALES DOMAIN
#    fact_sales_order · metrics_sales_order · dim_dealer · dim_vehicle_model
##############################################################################

mfg:Dealer a owl:Class ;
    rdfs:subClassOf mfg:Organization ;
    rdfs:comment "A sales channel partner that retails vehicles to customers." ;
    ea:boundToTable "dim.dim_dealer" ;
    ea:boundToKeyColumn "DEALER_KEY" ;
    ea:boundToNameColumn "DEALER_NAME" ;
    ea:boundToView "revenue_analytics.metrics_sales_order" ;
    ea:boundToField "dealer_name" ;
    ea:aka "dealer", "dealership", "channel partner" .

mfg:VehicleModel a owl:Class ;
    rdfs:subClassOf mfg:Product ;
    rdfs:comment "A vehicle model the enterprise manufactures and sells. Appears in both the revenue and manufacturing domains, which is what makes model the one entity joining sales to production." ;
    ea:boundToTable "dim.dim_vehicle_model" ;
    ea:boundToKeyColumn "MODEL_KEY" ;
    ea:boundToNameColumn "MODEL_NAME" ;
    ea:boundToView "revenue_analytics.metrics_sales_order" ;
    ea:boundToField "model_name" ;
    ea:aka "model", "vehicle model", "car model", "product" .

mfg:SalesOrder a owl:Class ;
    rdfs:subClassOf mfg:Event ;
    rdfs:comment "A customer order for a vehicle, placed through a dealer. One row per order in fact_sales_order — the grain of the revenue domain." ;
    ea:boundToView "revenue_analytics.metrics_sales_order" ;
    ea:boundToColumn "revenue_analytics.fact_sales_order" ;
    ea:domainTag "revenue" ;
    ea:grainTag "order" ;
    ea:aka "sales order", "order", "booking" .

mfg:SalesOrderStatus a owl:Class ;
    rdfs:comment "The fulfillment state of a sales order. The pipeline runs PROCESSING -> CONFIRMED -> DELIVERED. DELIVERED is a fulfilled vehicle sale and is NOT the marketing sense of conversion." ;
    ea:boundToColumn "revenue_analytics.fact_sales_order.STATUS" ;
    ea:boundToView "revenue_analytics.metrics_sales_order" ;
    ea:boundToField "order_status" ;
    ea:notSameAs ea:Conversion ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( mfg:SalesOrderStatus_PROCESSING mfg:SalesOrderStatus_CONFIRMED mfg:SalesOrderStatus_DELIVERED ) ] .
mfg:SalesOrderStatus_PROCESSING a mfg:SalesOrderStatus ;
    rdfs:label "PROCESSING" .
mfg:SalesOrderStatus_CONFIRMED a mfg:SalesOrderStatus ;
    rdfs:label "CONFIRMED" .
mfg:SalesOrderStatus_DELIVERED a mfg:SalesOrderStatus ;
    rdfs:label "DELIVERED" .

ea:Revenue a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "The default sales KPI: SUM(ORDER_AMOUNT) over sales orders, in INR. Never substitute BOOKING_AMOUNT unless the user explicitly asks for bookings." ;
    ea:boundToView "revenue_analytics.metrics_sales_order" ;
    ea:boundToMeasure "total_revenue" ;
    ea:notSameAs ea:Bookings ;
    ea:aka "revenue", "sales", "topline", "turnover" .

ea:Bookings a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Booked pipeline value: SUM(BOOKING_AMOUNT), in INR. This is order intake, not recognized revenue." ;
    ea:boundToView "revenue_analytics.metrics_sales_order" ;
    ea:boundToMeasure "total_bookings" ;
    ea:notSameAs ea:Revenue ;
    ea:aka "bookings", "booked value", "order intake", "pipeline" .

ea:Discount a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Discount given away on orders: SUM(DISCOUNT_AMOUNT), in INR. One of the three senses of the ambiguous word cost." ;
    ea:boundToView "revenue_analytics.metrics_sales_order" ;
    ea:boundToMeasure "total_discount" ;
    ea:notSameAs ea:DiscountPercent ;
    ea:aka "discount", "discount amount", "price give-away" .

ea:DiscountPercent a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Discount as a share of revenue: 100 * SUM(DISCOUNT_AMOUNT) / SUM(ORDER_AMOUNT). Unit is percent on a 0-100 scale, never a currency — do not render with a rupee symbol, and never average per-order ratios." ;
    ea:boundToView "revenue_analytics.metrics_sales_order" ;
    ea:boundToMeasure "discount_percent" ;
    ea:notSameAs ea:Discount ;
    ea:aka "discount percent", "discount rate", "discount %" .

ea:DeliveredOrderRevenue a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Revenue restricted to orders that reached STATUS = DELIVERED." ;
    ea:boundToView "revenue_analytics.metrics_sales_order" ;
    ea:boundToMeasure "delivered_order_revenue" ;
    ea:aka "delivered revenue", "fulfilled revenue" .


##############################################################################
# 2. MARKETING & CRM DOMAIN
#    fact_campaign_performance · metrics_campaign_performance
#    dim_campaign · dim_channel · dim_customer_segment
##############################################################################

mfg:MarketingCampaign a owl:Class ;
    rdfs:subClassOf mfg:Process ;
    rdfs:comment "A funded marketing effort run over a flight window across one or more channels." ;
    ea:boundToTable "dim.dim_campaign" ;
    ea:boundToKeyColumn "CAMPAIGN_KEY" ;
    ea:boundToNameColumn "CAMPAIGN_NAME" ;
    ea:boundToView "marketing_analytics.metrics_campaign_performance" ;
    ea:boundToField "campaign_name" ;
    ea:aka "campaign", "marketing campaign", "ad campaign" .

mfg:CampaignChannel a owl:Class ;
    rdfs:comment "A media channel a campaign runs on." ;
    ea:boundToTable "dim.dim_channel" ;
    ea:boundToKeyColumn "CHANNEL_KEY" ;
    ea:boundToNameColumn "CHANNEL_NAME" ;
    ea:boundToView "marketing_analytics.metrics_campaign_performance" ;
    ea:boundToField "channel_name" ;
    ea:aka "channel", "media channel" .

mfg:CustomerSegment a owl:Class ;
    rdfs:comment "An audience grouping a campaign is targeted at." ;
    ea:boundToTable "dim.dim_customer_segment" ;
    ea:boundToKeyColumn "SEGMENT_KEY" ;
    ea:boundToNameColumn "SEGMENT_NAME" ;
    ea:boundToView "marketing_analytics.metrics_campaign_performance" ;
    ea:boundToField "segment_name" ;
    ea:aka "segment", "customer segment", "audience" .

mfg:CampaignPerformanceRecord a owl:Class ;
    rdfs:subClassOf mfg:Measurement ;
    rdfs:comment "Measured delivery of one campaign on one channel over one flight. The grain of the marketing domain: one row per channel x campaign flight." ;
    ea:boundToView "marketing_analytics.metrics_campaign_performance" ;
    ea:boundToColumn "marketing_analytics.fact_campaign_performance" ;
    ea:domainTag "marketing" ;
    ea:grainTag "campaign_flight" .

ea:ROAS a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Spend-weighted return on ad spend. Values above 1.0 are a positive return. Must be rolled up as a weighted measure — AVG(ROAS) across rows is wrong because flights differ in spend." ;
    ea:boundToView "marketing_analytics.metrics_campaign_performance" ;
    ea:boundToMeasure "weighted_roas" ;
    ea:aka "ROAS", "return on ad spend", "ad return" .

ea:CostPerLead a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Cost per lead: SUM(ACTUAL_SPEND) / SUM(LEADS), in INR per lead. Never AVG(COST_PER_LEAD). One of the three senses of the ambiguous word cost." ;
    ea:boundToView "marketing_analytics.metrics_campaign_performance" ;
    ea:boundToMeasure "cost_per_lead" ;
    ea:aka "CPL", "cost per lead", "lead cost" .

ea:Conversion a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Campaign conversions recorded against marketing spend. This is a marketing funnel event and is NOT a sales order reaching DELIVERED." ;
    ea:boundToView "marketing_analytics.metrics_campaign_performance" ;
    ea:boundToMeasure "total_conversions" ;
    ea:notSameAs mfg:SalesOrderStatus ;
    ea:aka "conversions", "campaign conversions" .

ea:CampaignSpend a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Actual money spent running campaigns: SUM(ACTUAL_SPEND), in INR. One of the three senses of the ambiguous word cost." ;
    ea:boundToView "marketing_analytics.metrics_campaign_performance" ;
    ea:boundToMeasure "total_spend" ;
    ea:aka "spend", "ad spend", "campaign spend", "marketing cost" .


##############################################################################
# 3. PRODUCTION & MANUFACTURING EXECUTION DOMAIN
#    fact_production_execution · metrics_production_execution
#    dim_plant · dim_production_line · dim_vehicle_model
##############################################################################

mfg:Plant a owl:Class ;
    rdfs:subClassOf mfg:Facility ;
    rdfs:comment "A manufacturing site containing one or more production lines." ;
    ea:boundToTable "dim.dim_plant" ;
    ea:boundToKeyColumn "PLANT_KEY" ;
    ea:boundToNameColumn "PLANT_NAME" ;
    ea:boundToView "manufacturing_analytics.metrics_production_execution" ;
    ea:boundToField "plant_name" ;
    ea:aka "plant", "factory", "manufacturing site" .

mfg:ProductionLine a owl:Class ;
    rdfs:subClassOf mfg:Facility ;
    rdfs:comment "An assembly line inside a plant. Shift is not a dimension in the gold slice — SHIFT_CODE is a column on the production fact." ;
    ea:boundToTable "dim.dim_production_line" ;
    ea:boundToKeyColumn "LINE_KEY" ;
    ea:boundToNameColumn "LINE_NAME" ;
    ea:boundToView "manufacturing_analytics.metrics_production_execution" ;
    ea:boundToField "line_name" ;
    ea:aka "line", "production line", "assembly line" .

mfg:ProductionExecutionRecord a owl:Class ;
    rdfs:subClassOf mfg:Measurement ;
    rdfs:comment "Measured output of one production order on one line for one shift on one day — the grain of the manufacturing domain." ;
    ea:boundToView "manufacturing_analytics.metrics_production_execution" ;
    ea:boundToColumn "manufacturing_analytics.fact_production_execution" ;
    ea:domainTag "manufacturing" ;
    ea:grainTag "production_row" .

ea:OEE a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Overall equipment effectiveness, the product of availability, performance and quality. Stored on a 0-100 percent scale, as are its three components. Below 70% means OEE_PCT < 70. One of the two senses of the ambiguous word efficiency." ;
    ea:boundToView "manufacturing_analytics.metrics_production_execution" ;
    ea:boundToMeasure "average_oee" ;
    ea:boundToField "oee_below_70" ;
    ea:notSameAs ea:InventoryTurnover ;
    ea:aka "OEE", "overall equipment effectiveness", "equipment effectiveness" .

ea:Downtime a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Production downtime in minutes, from column DOWNTIME_MIN." ;
    ea:boundToView "manufacturing_analytics.metrics_production_execution" ;
    ea:boundToMeasure "total_downtime" ;
    ea:aka "downtime", "line stoppage", "lost minutes" .


##############################################################################
# 4. INVENTORY & LOGISTICS DOMAIN
#    fact_inventory_snapshot · metrics_inventory_snapshot
#    dim_part · dim_warehouse
##############################################################################

mfg:Part a owl:Class ;
    rdfs:subClassOf mfg:Product ;
    rdfs:comment "A vehicle part or component tracked in the parts catalog. Shared by the inventory and supplier-quality domains, which is what makes part the one entity joining stock to supplier performance." ;
    ea:boundToTable "dim.dim_part" ;
    ea:boundToKeyColumn "PART_KEY" ;
    ea:boundToNameColumn "PART_NAME" ;
    ea:boundToView "supply_chain_analytics.metrics_inventory_snapshot" ;
    ea:boundToField "Part Name" ;
    ea:aka "part", "component", "SKU", "material" .

mfg:Warehouse a owl:Class ;
    rdfs:subClassOf mfg:Facility ;
    rdfs:comment "A physical facility that stores parts inventory." ;
    ea:boundToTable "dim.dim_warehouse" ;
    ea:boundToKeyColumn "WAREHOUSE_KEY" ;
    ea:boundToNameColumn "WAREHOUSE_NAME" ;
    ea:boundToView "supply_chain_analytics.metrics_inventory_snapshot" ;
    ea:boundToField "Warehouse Name" ;
    ea:aka "warehouse", "stock location", "DC", "depot" .

mfg:StockPosition a owl:Class ;
    rdfs:subClassOf mfg:Measurement ;
    rdfs:comment "The on-hand position of one part at one warehouse on one day — the grain of the inventory domain. Point-in-time: filter is_current_snapshot = true for current stock, and never sum on-hand, safety stock or valuation across snapshot dates." ;
    ea:boundToView "supply_chain_analytics.metrics_inventory_snapshot" ;
    ea:boundToColumn "supply_chain_analytics.fact_inventory_snapshot" ;
    ea:domainTag "inventory" ;
    ea:grainTag "snapshot" .

ea:DaysOfSupply a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Point-in-time cover days for a part at a warehouse. Not cumulative across snapshot dates." ;
    ea:boundToView "supply_chain_analytics.metrics_inventory_snapshot" ;
    ea:boundToMeasure "Avg Days of Supply" ;
    ea:aka "days of supply", "DOS", "cover days", "stock cover" .

ea:InventoryTurnover a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Point-in-time inventory turnover ratio. The other sense of the ambiguous word efficiency — this is supply-chain efficiency, not equipment effectiveness." ;
    ea:boundToView "supply_chain_analytics.metrics_inventory_snapshot" ;
    ea:boundToMeasure "Avg Inventory Turnover" ;
    ea:notSameAs ea:OEE ;
    ea:aka "turnover", "inventory turnover", "stock turns" .

ea:StockValuation a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Value of stock on hand, in INR. Valid across parts and warehouses on a single snapshot date only." ;
    ea:boundToView "supply_chain_analytics.metrics_inventory_snapshot" ;
    ea:boundToMeasure "Total Stock Valuation" ;
    ea:aka "inventory value", "stock value", "stock valuation" .


##############################################################################
# 5. SUPPLIER QUALITY DOMAIN
#    fact_supplier_quality · metrics_supplier_quality · dim_supplier · dim_part
##############################################################################

mfg:Supplier a owl:Class ;
    rdfs:subClassOf mfg:Organization ;
    rdfs:comment "A vendor that supplies parts into the enterprise, measured on incoming quality." ;
    ea:boundToTable "dim.dim_supplier" ;
    ea:boundToKeyColumn "SUPPLIER_KEY" ;
    ea:boundToNameColumn "SUPPLIER_NAME" ;
    ea:boundToView "supply_chain_analytics.metrics_supplier_quality" ;
    ea:boundToField "Supplier Name" ;
    ea:aka "supplier", "vendor" .

mfg:QualityInspection a owl:Class ;
    rdfs:subClassOf mfg:Event ;
    rdfs:comment "An incoming-quality inspection of a supplied part — the grain of the supplier-quality domain, one row per inspection." ;
    ea:boundToView "supply_chain_analytics.metrics_supplier_quality" ;
    ea:boundToColumn "supply_chain_analytics.fact_supplier_quality" ;
    ea:domainTag "supplier_quality" ;
    ea:grainTag "inspection" ;
    ea:aka "inspection", "incoming inspection", "quality check" .

mfg:QualityDisposition a owl:Class ;
    rdfs:comment "The decision made about material found defective at inspection. The gold slice carries the short labels below; the enterprise ontology spells the last two as REWORK AT SOURCE and RETURN TO SUPPLIER — bind to the values that are actually in the column." ;
    ea:boundToColumn "supply_chain_analytics.fact_supplier_quality.DISPOSITION" ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( mfg:QualityDisposition_ACCEPT mfg:QualityDisposition_ACCEPT_AND_SORT mfg:QualityDisposition_REWORK_AT_SOURCE mfg:QualityDisposition_RETURN_TO_SUPPLIER ) ] .
mfg:QualityDisposition_ACCEPT a mfg:QualityDisposition ;
    rdfs:label "ACCEPT" .
mfg:QualityDisposition_ACCEPT_AND_SORT a mfg:QualityDisposition ;
    rdfs:label "ACCEPT & SORT" .
mfg:QualityDisposition_REWORK_AT_SOURCE a mfg:QualityDisposition ;
    rdfs:label "REWORK" .
mfg:QualityDisposition_RETURN_TO_SUPPLIER a mfg:QualityDisposition ;
    rdfs:label "RETURN" .

ea:PPM a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Parts-per-million defect rate: SUM(DEFECT_QTY) / SUM(INSPECTED_QTY) * 1e6. Lower is better. Never SUM or AVG the per-row PPM_LEVEL column — the ratio has to be recomputed over the rolled-up numerator and denominator." ;
    ea:boundToView "supply_chain_analytics.metrics_supplier_quality" ;
    ea:boundToMeasure "PPM" ;
    ea:aka "PPM", "defect rate", "parts per million" .

ea:COPQ a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Cost of poor quality: SUM(COST_OF_POOR_QUALITY), in INR. One of the three senses of the ambiguous word cost." ;
    ea:boundToView "supply_chain_analytics.metrics_supplier_quality" ;
    ea:boundToMeasure "Total Cost of Poor Quality" ;
    ea:aka "COPQ", "cost of poor quality", "quality cost" .

ea:QualityScore a owl:Class ;
    rdfs:subClassOf ea:KPI ;
    rdfs:comment "Average incoming-quality score for a supplier's parts. Higher is better." ;
    ea:boundToView "supply_chain_analytics.metrics_supplier_quality" ;
    ea:boundToMeasure "Avg Quality Score" ;
    ea:aka "quality score", "supplier score" .


##############################################################################
# 6. AMBIGUOUS SURFACE TERMS — the agent must ask before querying
##############################################################################

ea:Cost a owl:Class ;
    rdfs:subClassOf ea:AmbiguousTerm ;
    rdfs:comment "Ambiguous. Cost means campaign spend or cost per lead in marketing, cost of poor quality in supplier quality, and discount given away in revenue. Ask which before querying — do not guess." ;
    ea:disambiguatesTo ea:CampaignSpend, ea:CostPerLead, ea:COPQ, ea:Discount ;
    ea:aka "cost", "spend", "expense" .

ea:Efficiency a owl:Class ;
    rdfs:subClassOf ea:AmbiguousTerm ;
    rdfs:comment "Ambiguous. Efficiency means OEE in a production context and inventory turnover in a supply-chain context. Ask which before querying — do not default to OEE." ;
    ea:disambiguatesTo ea:OEE, ea:InventoryTurnover ;
    ea:aka "efficiency", "productivity", "how efficient" .


##############################################################################
# 7. OBJECT PROPERTIES — typed entity relations, materialized into kg_edges
#    Each is a distinct key pair drawn from the fact that already joins them.
##############################################################################

mfg:plantHasLine a owl:ObjectProperty ;
    rdfs:domain mfg:Plant ;
    rdfs:range mfg:ProductionLine ;
    rdfs:comment "A plant contains this production line." ;
    ea:edgeFrom "manufacturing_analytics.fact_production_execution" ;
    ea:edgeSubjectKey "PLANT_KEY" ;
    ea:edgeObjectKey "LINE_KEY" .

mfg:lineInPlant a owl:ObjectProperty ;
    rdfs:domain mfg:ProductionLine ;
    rdfs:range mfg:Plant ;
    rdfs:comment "Inverse of plantHasLine." ;
    owl:inverseOf mfg:plantHasLine .

mfg:lineProducesModel a owl:ObjectProperty ;
    rdfs:domain mfg:ProductionLine ;
    rdfs:range mfg:VehicleModel ;
    rdfs:comment "This line has built this vehicle model." ;
    ea:edgeFrom "manufacturing_analytics.fact_production_execution" ;
    ea:edgeSubjectKey "LINE_KEY" ;
    ea:edgeObjectKey "MODEL_KEY" .

mfg:modelProducedOnLine a owl:ObjectProperty ;
    rdfs:domain mfg:VehicleModel ;
    rdfs:range mfg:ProductionLine ;
    rdfs:comment "Inverse of lineProducesModel." ;
    owl:inverseOf mfg:lineProducesModel .

mfg:plantProducesModel a owl:ObjectProperty ;
    rdfs:domain mfg:Plant ;
    rdfs:range mfg:VehicleModel ;
    rdfs:comment "This plant has built this vehicle model. Derivable by composing plantHasLine with lineProducesModel, but materialized directly so single-hop plant-to-model questions do not need a join." ;
    ea:edgeFrom "manufacturing_analytics.fact_production_execution" ;
    ea:edgeSubjectKey "PLANT_KEY" ;
    ea:edgeObjectKey "MODEL_KEY" .

mfg:modelProducedAtPlant a owl:ObjectProperty ;
    rdfs:domain mfg:VehicleModel ;
    rdfs:range mfg:Plant ;
    rdfs:comment "Inverse of plantProducesModel." ;
    owl:inverseOf mfg:plantProducesModel .

mfg:dealerSellsModel a owl:ObjectProperty ;
    rdfs:domain mfg:Dealer ;
    rdfs:range mfg:VehicleModel ;
    rdfs:comment "This dealer has booked orders for this vehicle model." ;
    ea:edgeFrom "revenue_analytics.fact_sales_order" ;
    ea:edgeSubjectKey "DEALER_KEY" ;
    ea:edgeObjectKey "MODEL_KEY" .

mfg:modelSoldByDealer a owl:ObjectProperty ;
    rdfs:domain mfg:VehicleModel ;
    rdfs:range mfg:Dealer ;
    rdfs:comment "Inverse of dealerSellsModel." ;
    owl:inverseOf mfg:dealerSellsModel .

mfg:partStockedAt a owl:ObjectProperty ;
    rdfs:domain mfg:Part ;
    rdfs:range mfg:Warehouse ;
    rdfs:comment "This part is currently held at this warehouse. Restricted to the latest snapshot date so the edge describes the present, not every warehouse the part has ever sat in." ;
    ea:edgeFrom "supply_chain_analytics.fact_inventory_snapshot" ;
    ea:edgeSubjectKey "PART_KEY" ;
    ea:edgeObjectKey "WAREHOUSE_KEY" ;
    ea:edgeFilter "SNAPSHOT_DATE_KEY = (SELECT MAX(SNAPSHOT_DATE_KEY) FROM {source})" .

mfg:warehouseStocksPart a owl:ObjectProperty ;
    rdfs:domain mfg:Warehouse ;
    rdfs:range mfg:Part ;
    rdfs:comment "Inverse of partStockedAt." ;
    owl:inverseOf mfg:partStockedAt .

mfg:supplierSuppliesPart a owl:ObjectProperty ;
    rdfs:domain mfg:Supplier ;
    rdfs:range mfg:Part ;
    rdfs:comment "This supplier has delivered this part for incoming inspection." ;
    ea:edgeFrom "supply_chain_analytics.fact_supplier_quality" ;
    ea:edgeSubjectKey "SUPPLIER_KEY" ;
    ea:edgeObjectKey "PART_KEY" .

mfg:partSuppliedBy a owl:ObjectProperty ;
    rdfs:domain mfg:Part ;
    rdfs:range mfg:Supplier ;
    rdfs:comment "Inverse of supplierSuppliesPart. Composing this with partStockedAt answers which suppliers feed a given warehouse." ;
    owl:inverseOf mfg:supplierSuppliesPart .

mfg:campaignRunsOnChannel a owl:ObjectProperty ;
    rdfs:domain mfg:MarketingCampaign ;
    rdfs:range mfg:CampaignChannel ;
    rdfs:comment "This campaign ran a flight on this media channel." ;
    ea:edgeFrom "marketing_analytics.fact_campaign_performance" ;
    ea:edgeSubjectKey "CAMPAIGN_KEY" ;
    ea:edgeObjectKey "CHANNEL_KEY" .

mfg:channelCarriesCampaign a owl:ObjectProperty ;
    rdfs:domain mfg:CampaignChannel ;
    rdfs:range mfg:MarketingCampaign ;
    rdfs:comment "Inverse of campaignRunsOnChannel." ;
    owl:inverseOf mfg:campaignRunsOnChannel .

mfg:campaignTargetsSegment a owl:ObjectProperty ;
    rdfs:domain mfg:MarketingCampaign ;
    rdfs:range mfg:CustomerSegment ;
    rdfs:comment "This campaign was aimed at this customer segment." ;
    ea:edgeFrom "marketing_analytics.fact_campaign_performance" ;
    ea:edgeSubjectKey "CAMPAIGN_KEY" ;
    ea:edgeObjectKey "SEGMENT_KEY" .

mfg:segmentTargetedByCampaign a owl:ObjectProperty ;
    rdfs:domain mfg:CustomerSegment ;
    rdfs:range mfg:MarketingCampaign ;
    rdfs:comment "Inverse of campaignTargetsSegment." ;
    owl:inverseOf mfg:campaignTargetsSegment .


##############################################################################
# 7.1 BINDING HAZARD — the repo's metric-view SQL disagrees with what is deployed
#
#   The measure bindings above were verified against the LIVE gold_dev views by
#   src/ontology/verify_bindings.py. Two of those views no longer match the .sql
#   files that supposedly define them:
#
#     metrics_inventory_snapshot   deployed: 'Avg Days of Supply', 'Avg Inventory
#                                  Turnover', 'Total Stock Valuation', 'Part Name',
#                                  'Warehouse Name', 'Stockout Risk'
#                                  repo .sql: average_days_of_supply, average_turnover,
#                                  total_stock_valuation, part_name, warehouse_name,
#                                  stockout_risk
#     metrics_supplier_quality     deployed: 'PPM', 'Avg Quality Score', 'Total Cost of
#                                  Poor Quality', 'Supplier Name'
#                                  repo .sql: ppm, average_quality_score, copq,
#                                  supplier_name
#
#   The other three views (revenue, marketing, manufacturing) are snake_case in both
#   places and agree. Whoever rebuilt the two supply_chain views did not update the
#   repo, so running ./deploy.sh apply-metrics with the metric-view CREATE tasks
#   re-enabled would overwrite them, rename every measure back to snake_case, and
#   break all nine bindings again.
#
#   Resolve by picking one convention and making the .sql files match the choice.
#   Until then these bindings track the deployed reality, because that is what the
#   agent queries. Re-run verify_bindings.py after any metric-view change.
##############################################################################


##############################################################################
# 8. KNOWN GAPS — relations the gold slice cannot yet support
#
#   Campaign -> SalesOrder   no bridge table joins marketing spend to orders,
#                            so marketing attribution to revenue is out of reach.
#   Plant    -> Part         no fact links a plant or line to the parts it
#                            consumes, so "which suppliers feed Plant X" cannot
#                            be answered end to end. Plant -> Model and
#                            Supplier -> Part both exist; the middle hop does not.
#   Warehouse -> Plant       dim_warehouse has no confirmed plant reference in
#                            the gold slice.
#
#   Add each as an object property here the moment the backing table lands;
#   the generator will pick it up with no other change.
##############################################################################
